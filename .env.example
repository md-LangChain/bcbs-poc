LANGSMITH_TRACING=true
LANGSMITH_PROJECT=bcbs-poc
LANGSMITH_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
#
# agents/ FA-1 traces (FA-2 stays on LANGSMITH_PROJECT above):
# LANGSMITH_FA1_PROJECT=bcbs-poc-fa1
#
# mixed-agents LangSmith projects (same Application=bcbs-poc):
# LANGSMITH_MIXED_FA1_PROJECT=bcbs-mixed-fa1
# LANGSMITH_MIXED_FA2_PROJECT=bcbs-mixed-fa2
# LANGSMITH_MIXED_PROJECT=bcbs-mixed
# LANGSMITH_APPLICATION=bcbs-poc
# LANGSMITH_THREAD_IDLE_SECONDS=600
#
# Microsoft Agent Framework → LangSmith via OpenTelemetry
# (https://docs.langchain.com/langsmith/trace-with-microsoft-agent-framework)
# mixed-agents/fa_1.py and weather_agent.py configure these automatically:
# ENABLE_INSTRUMENTATION=true
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://api.smith.langchain.com/otel/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=<LANGSMITH_API_KEY>,Langsmith-Project=bcbs-mixed-fa1
#
# mixed-agents weather chat demo:
#   uv run python mixed-agents/weather_agent.py
# OPENAI_MODEL=gpt-4.1-mini
