LANGSMITH_TRACING=true
LANGSMITH_PROJECT=bcbs-poc
LANGSMITH_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
#
# mixed-agents uses a separate tracing project under the same Application:
# LANGSMITH_MIXED_PROJECT=bcbs-mixed
# LANGSMITH_APPLICATION=bcbs-poc
# LANGSMITH_THREAD_IDLE_SECONDS=600
#
# Microsoft Agent Framework → LangSmith via OpenTelemetry (set in mixed-agents/fa_1.py):
# ENABLE_INSTRUMENTATION=true
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://api.smith.langchain.com/otel/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=<LANGSMITH_API_KEY>,Langsmith-Project=bcbs-mixed
