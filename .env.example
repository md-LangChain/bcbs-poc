# bcbs-poc — copy to .env and fill in the values below.
#
#   cp .env.example .env
#
# Loaded from the repo root by every agent (load_dotenv) and by the LangGraph
# server ("env": ".env" in langgraph.json).
#
# Local run: the root langgraph.json registers all four graphs, so one server
# serves intake, validation, eligibility and a2a-validation together:
#
#   uv run langgraph dev          # -> http://127.0.0.1:2024
#
# Point a UI at that URL with assistant_id "validation".

# ===========================================================================
# 1. Fill these in
# ===========================================================================

# LangSmith. The key is workspace-scoped — it is what selects which workspace
# everything below lands in. Three call sites use os.environ[...] and raise
# KeyError if unset: validation pulling its system prompt at import, intake
# calling eligibility, and a2a-validation calling intake.
LANGSMITH_API_KEY=

# Model credentials. Not referenced by name anywhere in this repo —
# init_chat_model("openai:gpt-4.1-mini") and the OpenAI SDK read it implicitly.
OPENAI_API_KEY=

# Without this there are no traces, and the observability half of the POC has
# nothing to show.
LANGSMITH_TRACING=true

# Read natively by the langsmith SDK. Only set for a non-US workspace.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Only needed if your API key is org-scoped rather than workspace-scoped.
# LANGSMITH_WORKSPACE_ID=

# ===========================================================================
# 2. Eligibility — where intake looks it up
# ===========================================================================
#
# intake calls this during validate_case, on every case, including when you
# run intake by itself. The deployed default in intake.py lives in someone
# else's workspace, so in your own workspace use local or deploy your own.
#
#   local       http://127.0.0.1:2024   same server as everything else
#   your deploy https://<your-eligibility-deployment>.us.langgraph.app

ELIGIBILITY_URL=http://127.0.0.1:2024
ELIGIBILITY_GRAPH=eligibility

# ===========================================================================
# 3. Validation's system prompt  ← the one that will block your first run
# ===========================================================================
#
# validation.py pulls this from LangSmith Context Hub at MODULE IMPORT, so a
# missing context or an unpromoted version fails at startup, not at request
# time — it looks like a broken install.
#
# A fresh workspace does not have it. Before your first run, create a Context
# Hub context with the name below, give it an AGENTS.md file containing the
# validation system prompt, and promote a version tagged "production".
# Or point these at a context you have already created.

LANGSMITH_VALIDATION_CONTEXT=bcbs-validation-system-prompt
LANGSMITH_VALIDATION_CONTEXT_VERSION=production

# ===========================================================================
# 4. Workspace setup for the eval scripts  (not needed for the UI)
# ===========================================================================
#
# Skip this whole section if you just want to talk to the validation agent.
# It only matters for scripts/ and the CI experiments. Four resources are
# referenced by name or ID and must exist in your workspace first:
#
#   a) Application resource tag "bcbs-poc"
#      Settings -> Resource tags -> key "Application", value "bcbs-poc".
#      scripts/createDataset.py raises ValueError if it is missing.
#
#   b) Dataset "PriorAuth Dataset"
#      uv run python scripts/createDataset.py
#
#   c) Dataset "PriorAuth Prompt Injection"
#      uv run python scripts/createPromptInjectionDataset.py
#
#   d) Dataset "PriorAuth Golden Dataset"
#      Read by scripts/runFunctionalExperiment.py, but NO script creates it.
#      You have to make it by hand, or repoint that script.
#
#   e) Workspace evaluator "PHI Detection", attached to "PriorAuth Dataset",
#      emitting feedback key "phi". scripts/runPhiExperiment.py polls for that
#      feedback and fails CI when the average is above 0. Configured in the
#      LangSmith UI, not in code — the id in its docstring is from the
#      original workspace and will not match yours.
#
# Note: only the prompt-injection dataset name is configurable by env. The
# other three are hardcoded in scripts/, so create them under these exact
# names or edit the scripts.

# LANGSMITH_PROMPT_INJECTION_DATASET=PriorAuth Prompt Injection
# LANGSMITH_APPLICATION=bcbs-poc

# scripts/createDataset.py reads LANGSMITH_PROJECT as its Application tag.
# The agents ignore it — each overwrites it at import
# (bcbs-validation-agent / bcbs-intake-agent / bcbs-eligibility-agent).
# LANGSMITH_PROJECT=bcbs-poc

# ===========================================================================
# 5. Optional
# ===========================================================================

# Route model calls through the LangSmith LLM Gateway instead of OpenAI direct.
# When set, OPENAI_API_KEY should be the gateway key. CI uses this pair.
# The model configuration must exist in your workspace under this name.
# See scripts/gateway.py for the URL shape (do not append a second /v1).
# OPENAI_BASE_URL=https://gateway.smith.langchain.com/models/<model-config-name>
# LANGSMITH_GATEWAY_MODEL_CONFIG=gpt-4.1-nano

# agents/scenarios/a2a-validation.py only — the cross-deployment variant that
# calls intake over HTTP instead of importing it in-process. Not needed for the
# normal validation agent. The default URL is another workspace's deployment.
# Blank assistant id is resolved from the graph name.
# INTAKE_URL=http://127.0.0.1:2024
# INTAKE_GRAPH=intake
# INTAKE_ASSISTANT_ID=

# mixed-agents/ only — the Microsoft Agent Framework variant.
# OPENAI_MODEL=gpt-4.1-mini
# LANGSMITH_MIXED_PROJECT=bcbs-mixed
# LANGSMITH_MIXED_INTAKE_PROJECT=bcbs-mixed-intake
# LANGSMITH_THREAD_IDLE_SECONDS=600
